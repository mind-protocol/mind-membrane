[Unit]
Description=Mind Membrane MCP Server (Linux-native, L4 policies)
After=network.target
Documentation=https://github.com/mind-protocol/mind-membrane

[Service]
Type=simple
User=mind-protocol
Group=mind-protocol
WorkingDirectory=/home/mind-protocol/mind-membrane/apps/server
EnvironmentFile=/home/mind-protocol/.env.mcp

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mind-protocol/mindprotocol/consciousness/citizens
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Execution
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mind-membrane

# Limits
LimitNOFILE=65536
TasksMax=256

[Install]
WantedBy=multi-user.target
